# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# keep example files so forkers have a template to copy
!.env.local.example
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase
supabase/.temp/

# generated locally: contains the WAHA webhook token
.waha-webhook-url.txt
# generated locally: previous WAHA webhook list, written before each re-register
.waha-webhooks.backup-*.json

# local secrets that must never be tracked, whatever they are named.
# Belt and braces next to the .env* rule above — a stray `secrets.env`
# inside a subdirectory is not matched by a root-level `.env*` pattern,
# but is matched by these.
.secrets/
secrets/
*.secret
*.secrets
credentials.json
service-account*.json
cloudflared-token*
# private keys (public halves, *.pub, stay trackable on purpose)
*.pem
*.key
*.p12
*.pfx
!**/*.pub

# image exports for the deploy (`docker save` writes these next to the
# repo). ~250 MB each — never trackable, and stale copies shadow the real
# one. Deploy is build + `docker save` + transfer, not a commit.
wacrm.tar
*.tar

# local pre-change snapshots taken while operating on production data
# (the previous phone_number_id, before a number swap). Operational, not
# source — the value is per-instance and must not be published.
.phone-number-id.backup.txt
*.backup.txt


# Artefatos do backfill de mídia (scripts/plan-media-backfill.mjs).
# Contêm URLs e ids de produção — não são código, não vão para o repo.
backfill-plan.json
backfill-backup.json
backfill-verdict.json
backfill-dryrun.json
backfill-fix2.json

# Backup local de dados (nunca versionar)
scripts/.backup-*.json
